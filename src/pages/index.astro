---
import '../styles/global.css';

const title = 'ASESORAMIENTO';
const description = 'Presentación de asesoramiento.';
const assetBase = import.meta.env.BASE_URL;

const practices = [
  {
    title: 'Liderazgo',
    icon: `${assetBase}assets/icons/leadership.png`,
    items: [
      'Diseño del plan estrátegico de la empresa.',
      'Gestión de cambio: Como afrontar cambios tecnológicos, de mercado, modelo de negocios, organizaciones, etc.',
      'Desarrollo de líderes para enfrentar retos actuales y futuros.',
    ],
  },
  {
    title: 'Cultura Organizacional',
    icon: `${assetBase}assets/icons/organizational-culture.png`,
    items: [
      'Compromiso del empleado: Involucramiento tanto en el trabajo como en los objetivos y valores de la empresa.',
      'Gestion integral del talento de la organizacion.',
      'Colaboración entre departamentos.',
    ],
  },
  {
    title: 'Optimización de Ventas',
    icon: `${assetBase}assets/icons/sales-optimization.png`,
    items: [
      'Estudios de mercado.',
      'Lanzamiento de nuevos productos.',
      'Entrenamiento, ventas consultivas.',
      'Metodologia de ventas (Embudo, CRM).',
    ],
  },
  {
    title: 'Gestión de la experiencia del cliente',
    icon: `${assetBase}assets/icons/customer-experience.png`,
    items: [
      'Retención de clientes.',
      'Crear fidelidad a través de los puntos de contacto con los clientes.',
      'Desarrollar y establecer sociedades (partnerships).',
    ],
  },
  {
    title: 'Eficiencia operacional',
    icon: `${assetBase}assets/icons/operational-efficiency.png`,
    items: [
      'Evaluación de la operatividad de la empresa.',
      'Diagramas de procesos.',
      'Analisis, diseño e implementación de procesos para mejorar la productividad.',
      'Evaluacion de desperdicios.',
      'Análisis FODA (Fortalezas, Oportunidades, Debilidades, Amenazas).',
      'Métricas de gestión.',
      'Creación de Tableros de Control.',
    ],
  },
  {
    title: 'Transformación Digital y Marketing Digital',
    icon: `${assetBase}assets/icons/digital-marketing.png`,
    iconAlt: 'Icono de marketing digital',
    items: [
      'Digitalización, automatización y desarrollo de soluciones empresariales.',
      'Integración de sistemas, herramientas de gestión y CRM.',
      'Desarrollo de tableros de control e indicadores de gestión.',
      'Desarrollo de landing pages, formularios y canales de captación.',
      'Gestión de campañas publicitarias en Meta Ads.',
      'Generación, seguimiento y medición de oportunidades comerciales.',
    ],
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4f0" />
    <link rel="icon" type="image/jpeg" href={`${assetBase}assets/brand/ag-consulting-logo.jpeg`} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header" aria-label="AG Consulting">
      <img class="header-logo" src={`${assetBase}assets/brand/ag-consulting-logo.jpeg`} alt="AG Consulting" hidden />
    </header>
    <main>
      <section class="opening section-shell" aria-label="Presentación de asesoramiento">
        <div class="opening-paper" aria-hidden="true"></div>
        <div class="editorial-frame opening-frame">
          <div class="opening-copy">
            <div class="opening-text">
              <h1 class="opening-title">
                <span class="opening-line">Somos una empresa</span>
                <span class="opening-line">de consultoría</span>
                <span class="opening-line">y asesoramiento.</span>
              </h1>
            </div>
            <div class="opening-brand">
              <img class="opening-logo" src={`${assetBase}assets/brand/ag-consulting-logo.jpeg`} alt="AG Consulting" width="1600" height="751" />
            </div>
          </div>
        </div>
        <span class="section-index" aria-hidden="true">01 / 08</span>
      </section>

      <section class="identity section-shell" aria-labelledby="identity-title">
        <div class="editorial-frame identity-frame">
        <div class="section-heading">
          <p class="eyebrow">01 — Identidad</p>
          <h2 id="identity-title">¿Quiénes somos?</h2>
        </div>
        <div class="identity-content">
          <p class="lead">Somos profesionales en planeación estratégica que mediante distintas metodologías:</p>
          <ul class="verb-list">
            <li>
              <svg class="method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="10" cy="10" r="6.5" />
                <path class="method-accent" d="m15 15 5.5 5.5" />
              </svg>
              <span>Identificamos</span>
            </li>
            <li>
              <svg class="method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9" />
                <circle cx="12" cy="12" r="5" />
                <circle class="method-accent" cx="12" cy="12" r="1" />
              </svg>
              <span>Priorizamos</span>
            </li>
            <li>
              <svg class="method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="m4 15 12-12 5 5-12 12-6 1Z" />
                <path class="method-accent" d="m13 6 5 5" />
                <path d="m4 15 5 5" />
              </svg>
              <span>Diseñamos</span>
            </li>
            <li>
              <svg class="method-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9" />
                <path class="method-accent" d="m7.5 12 3 3 6-6" />
              </svg>
              <span>Implementamos</span>
            </li>
          </ul>
          <p class="identity-ending">Cambios sustentables en las empresas.</p>
        </div>
        </div>
        <span class="section-index" aria-hidden="true">02 / 08</span>
      </section>

      <section class="what section-shell" aria-labelledby="what-title">
        <div class="editorial-frame what-frame">
        <div class="section-heading">
          <p class="eyebrow">02 — Nuestro trabajo</p>
          <h2 id="what-title">¿Qué hacemos?</h2>
        </div>
        <div class="what-content">
          <p class="lead">Ayudamos a empresas a:</p>
          <ul class="growth-list">
            <li>
              <svg class="outcome-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M3 3v18h18" />
                <path class="outcome-accent" d="m6 15 5-5 4 3 6-8m-5 0h5v5" />
              </svg>
              <span>Crecer</span>
            </li>
            <li>
              <svg class="outcome-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M3 3v18h9M7 16v-5m4 2V7" />
                <circle cx="18" cy="16" r="5" />
                <path class="outcome-accent" d="M18 13v6m1.5-5H17a1 1 0 0 0 0 2h2a1 1 0 0 1 0 2h-2.5" />
              </svg>
              <span>Incrementar rentabilidad</span>
            </li>
          </ul>
          <p class="supporting-copy">A través de un enfoque sistemático en los valores del cliente.</p>
        </div>
        </div>
        <span class="section-index" aria-hidden="true">03 / 08</span>
      </section>

      <section class="approach section-shell" aria-labelledby="approach-title">
        <div class="editorial-frame approach-frame">
        <div class="section-heading">
          <p class="eyebrow">03 — Enfoque</p>
          <h2 id="approach-title">¿Cómo lo hacemos?</h2>
        </div>
        <p class="approach-copy">Sintonizando las metas, políticas, procesos, la cultura organizacional y ventas con la experiencia del cliente</p>
        </div>
        <span class="section-index" aria-hidden="true">04 / 08</span>
      </section>

      <section class="practices section-shell" aria-labelledby="practices-title">
        <div class="editorial-frame practices-frame">
        <div class="section-heading practices-heading">
          <p class="eyebrow">04 — Áreas de trabajo</p>
          <h2 id="practices-title">Prácticas de Consultoría</h2>
        </div>
        <div class="practice-grid">
          {practices.map((practice) => (
            <article class="practice-card">
              <div class="practice-card-heading">
                <img src={practice.icon} alt={practice.iconAlt ?? ''} loading="lazy" />
                <h3>{practice.title}</h3>
              </div>
              <ul>
                {practice.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
        </div>
        <span class="section-index" aria-hidden="true">05 / 08</span>
      </section>

      <section class="purpose section-shell" aria-labelledby="purpose-title">
        <div class="editorial-frame purpose-frame">
        <div class="section-heading">
          <p class="eyebrow">05 — Propósito</p>
          <h2 id="purpose-title">¿Por qué lo hacemos?</h2>
        </div>
        <p class="purpose-copy">Porque creemos que la rentabilidad indica el valor que la empresa entrega a la sociedad.</p>
        </div>
        <span class="section-index" aria-hidden="true">06 / 08</span>
      </section>

      <section class="robotics section-shell" aria-labelledby="robotics-title">
        <div class="editorial-frame robotics-frame">
          <div class="robotics-copy">
            <p class="eyebrow">06 — Automatización</p>
            <h2 id="robotics-title">Robótica Industrial</h2>
            <p class="lead">Diseñamos e integramos celdas robóticas para automatizar tareas repetitivas y procesos operativos.</p>
            <ul class="robotics-capabilities">
              <li>Pick and place</li>
              <li>Paletizado</li>
              <li>Diseño e integración de celdas robóticas</li>
              <li>Programación, control y puesta en marcha</li>
              <li>Visión artificial y sistemas de seguridad</li>
              <li>Integración con líneas, PLC y sistemas de gestión</li>
            </ul>
            <p class="robotics-closing">Automatización aplicada para lograr procesos más consistentes, seguros y eficientes.</p>
          </div>
          <div class="robotics-art">
            <img src={`${assetBase}assets/illustrations/industrial-robotics.png`} alt="Brazo robótico industrial trabajando con cajas sobre una línea de producción" width="1254" height="1254" loading="lazy" />
          </div>
        </div>
        <span class="section-index" aria-hidden="true">07 / 08</span>
      </section>

      <section class="closing section-shell" aria-labelledby="closing-title">
        <div class="editorial-frame closing-frame">
        <div class="closing-copy">
          <h2 id="closing-title">Agendemos una reunión</h2>
          <p class="closing-invitation">Si le interesa saber más, podemos agendar una reunión. Contáctenos por correo o teléfono.</p>
        </div>
        <address class="closing-art">
            <a href="mailto:miguel.oportoag@gmail.com">
              <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path class="contact-accent" d="m3 6 9 7 9-7" />
              </svg>
              <span>miguel.oportoag@gmail.com</span>
            </a>
            <a href="tel:+59178002275">
              <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <path d="M7 3H4a1 1 0 0 0-1 1c0 9.4 7.6 17 17 17a1 1 0 0 0 1-1v-3l-5-2-2 2a15 15 0 0 1-7-7l2-2Z" />
                <path class="contact-accent" d="M14 3a7 7 0 0 1 7 7m-7-3a3 3 0 0 1 3 3" />
              </svg>
              <span>+591 78002275</span>
            </a>
        </address>
        </div>
        <span class="section-index" aria-hidden="true">08 / 08</span>
      </section>
    </main>
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const header = document.querySelector<HTMLElement>('.site-header');
      const headerLogo = document.querySelector<HTMLImageElement>('.header-logo');
      const darkSections = document.querySelectorAll<HTMLElement>('.approach, .robotics');
      const updateHeaderContrast = () => {
        const footprint = header.getBoundingClientRect();
        const x = footprint.left + footprint.width / 2;
        const y = footprint.top + footprint.height / 2;
        // Sample the fixed logo's position, not a section's viewport midpoint.
        const onDark = Array.from(darkSections).some((section) => {
          const bounds = section.getBoundingClientRect();
          return x >= bounds.left && x < bounds.right && y >= bounds.top && y < bounds.bottom;
        });
        header.toggleAttribute('data-on-dark', onDark);
      };

      updateHeaderContrast();
      window.addEventListener('scroll', updateHeaderContrast, { passive: true });
      window.addEventListener('resize', updateHeaderContrast);
      headerLogo.addEventListener('load', updateHeaderContrast);

      if (reduceMotion.matches) {
        const hero = document.querySelector('.opening');
        const updateHeaderLogo = () => {
          headerLogo.hidden = window.scrollY < hero.getBoundingClientRect().height;
          updateHeaderContrast();
        };

        updateHeaderLogo();
        window.addEventListener('scroll', updateHeaderLogo, { passive: true });
        window.addEventListener('resize', updateHeaderLogo);
      } else {
        const [{ gsap }, { ScrollTrigger }] = await Promise.all([
          import('gsap'),
          import('gsap/ScrollTrigger'),
        ]);

        gsap.registerPlugin(ScrollTrigger);
        headerLogo.hidden = false;
        updateHeaderContrast();
        const hero = document.querySelector('.opening');
        const heroTitle = document.querySelector('.opening-title');
        const heroLogo = document.querySelector('.opening-logo');
        const revealTargets = gsap.utils.toArray(
          '.identity-content, .what-content, .approach-copy, .purpose-copy, .robotics-copy, .robotics-art, .closing-copy, .closing-art',
        );
        const headingGroups = gsap.utils.toArray('main h1:not(.opening-title), main h2').map((heading) => {
          const label = heading.textContent.trim();
          heading.setAttribute('aria-label', label);
          heading.innerHTML = label
            .split(/\s+/)
            .map((word) => `<span aria-hidden="true">${word}</span>`)
            .join(' ');
          return { heading, words: gsap.utils.toArray('span', heading) };
        });
        const headingWords = headingGroups.flatMap(({ words }) => words);
        const practiceCards = gsap.utils.toArray('.practice-card');
        const practiceIcons = gsap.utils.toArray('.practice-card-heading img');
        const practiceTitles = gsap.utils.toArray('.practice-card-heading h3');
        const practiceItems = gsap.utils.toArray('.practice-card li');

        gsap.set([headerLogo, ...revealTargets, ...practiceCards], { autoAlpha: 0 });
        gsap.set(headingWords, { autoAlpha: 0, y: 10 });
        gsap.set([heroTitle, heroLogo, ...practiceTitles], { autoAlpha: 0, y: 8 });
        gsap.set(practiceIcons, { autoAlpha: 0, y: 6, scale: 0.97 });
        gsap.set(practiceItems, { autoAlpha: 0, y: 6 });
        document.documentElement.classList.add('motion-enabled');

        const heroTimeline = gsap.timeline({
          defaults: { ease: 'power3.out' },
        });
        heroTimeline
          .to(heroTitle, { autoAlpha: 1, y: 0, duration: 0.65 })
          .to(heroLogo, { autoAlpha: 1, y: 0, duration: 0.7 }, '-=0.28');

        gsap.to(headerLogo, {
          autoAlpha: 1,
          y: 0,
          duration: 0.3,
          ease: 'power1.out',
          scrollTrigger: {
            trigger: hero,
            start: 'bottom top',
            toggleActions: 'play none none reverse',
          },
        });

        headingGroups
          .forEach(({ heading, words }) => {
          gsap.to(words, {
            autoAlpha: 1,
            y: 0,
            duration: 0.75,
            ease: 'power3.out',
            stagger: { each: 0.055, amount: 0.22 },
            scrollTrigger: {
              trigger: heading,
              start: 'top 88%',
              once: true,
            },
          });
          });

        revealTargets.forEach((target) => {
          gsap.to(target, {
            autoAlpha: 1,
            y: 0,
            duration: 0.75,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: target,
              start: 'top 88%',
              once: true,
            },
          });
        });

        const practiceTimeline = gsap.timeline({
          scrollTrigger: {
            trigger: '.practice-grid',
            start: 'top 88%',
            once: true,
          },
          defaults: { ease: 'power3.out' },
        });
        practiceTimeline
          .to(practiceCards, {
            autoAlpha: 1,
            y: 0,
            duration: 0.75,
            stagger: { each: 0.09, amount: 0.36 },
          })
          .to(practiceIcons, {
            autoAlpha: 1,
            y: 0,
            scale: 1,
            duration: 0.7,
            stagger: { each: 0.06, amount: 0.24 },
          }, '-=0.55')
          .to(practiceTitles, {
            autoAlpha: 1,
            y: 0,
            duration: 0.7,
            stagger: { each: 0.06, amount: 0.24 },
          }, '-=0.58')
          .to(practiceItems, {
            autoAlpha: 1,
            y: 0,
            duration: 0.65,
            stagger: { each: 0.025, amount: 0.45 },
          }, '-=0.5');

        const parallaxMedia = gsap.matchMedia();
        parallaxMedia.add('(min-width: 760px)', () => {
          gsap.utils.toArray('.robotics-art img, .closing-art img').forEach((artwork) => {
            gsap.to(artwork, {
              y: 16,
              ease: 'none',
              scrollTrigger: {
                trigger: artwork.parentElement,
                start: 'top bottom',
                end: 'bottom top',
                scrub: 0.6,
              },
            });
          });
        });

        const snapMedia = gsap.matchMedia();
        snapMedia.add('(min-width: 760px)', () => {
          const narrativePanels = gsap.utils.toArray(
            '.opening, .identity, .what, .approach, .purpose, .robotics, .closing',
          );
          const practices = document.querySelector('.practices');
          const proximity = 220;

          ScrollTrigger.create({
            trigger: document.body,
            start: 'top top',
            end: 'max',
            snap: {
              snapTo: (progress, self) => {
                const maxScroll = ScrollTrigger.maxScroll(window);
                const projectedScroll = progress * maxScroll;
                const practicesStart = practices.getBoundingClientRect().top + window.scrollY;
                const practicesEnd = practicesStart + practices.offsetHeight;

                if (projectedScroll >= practicesStart && projectedScroll <= practicesEnd) {
                  return progress;
                }

                const nearestPanelStart = narrativePanels.reduce((nearest, panel) => {
                  const panelStart = panel.getBoundingClientRect().top + window.scrollY;
                  return Math.abs(panelStart - projectedScroll) < Math.abs(nearest - projectedScroll)
                    ? panelStart
                    : nearest;
                }, Number.POSITIVE_INFINITY);

                return Math.abs(nearestPanelStart - projectedScroll) <= proximity
                  ? nearestPanelStart / maxScroll
                  : progress;
              },
              delay: 0.12,
              duration: { min: 0.15, max: 0.35 },
              ease: 'power1.out',
              inertia: false,
            },
          });
        });
      }
    </script>
  </body>
</html>
