---
import '../styles/global.css';

const title = 'CONSULTING';
const description = 'Presentación de asesoramiento.';

const practices = [
  {
    title: 'Liderazgo',
    icon: '/assets/icons/leadership.png',
    items: [
      'Diseño del plan estrátegico de la empresa.',
      'Gestión de cambio: Como afrontar cambios tecnológicos, de mercado, modelo de negocios, organizaciones, etc.',
      'Desarrollo de líderes para enfrentar retos actuales y futuros.',
    ],
  },
  {
    title: 'Cultura Organizacional',
    icon: '/assets/icons/organizational-culture.png',
    items: [
      'Compromiso del empleado: Involucramiento tanto en el trabajo como en los objetivos y valores de la empresa.',
      'Gestion integral del talento de la organizacion.',
      'Colaboración entre departamentos.',
    ],
  },
  {
    title: 'Optimización de Ventas',
    icon: '/assets/icons/sales-optimization.png',
    items: [
      'Estudios de mercado.',
      'Lanzamiento de nuevos productos.',
      'Entrenamiento, ventas consultivas.',
      'Metodologia de ventas (Embudo, CRM).',
    ],
  },
  {
    title: 'Gestión de la experiencia del cliente',
    icon: '/assets/icons/customer-experience.png',
    items: [
      'Retención de clientes.',
      'Crear fidelidad a través de los puntos de contacto con los clientes.',
      'Desarrollar y establecer sociedades (partnerships).',
    ],
  },
  {
    title: 'Eficiencia operacional',
    icon: '/assets/icons/operational-efficiency.png',
    items: [
      'Evaluación de la operatividad de la empresa.',
      'Diagramas de procesos.',
      'Analisis, diseño e implementación de procesos para mejorar la productividad.',
      'Evaluacion de desperdicios.',
      'Análisis FODA (Fortalezas, Oportunidades, Debilidades, Amenazas).',
      'Métricas de gestión.',
      'Creación de Tableros de Control.',
    ],
  },
  {
    title: 'Transformación Digital y Marketing Digital',
    icon: '/assets/icons/digital-marketing.png',
    iconAlt: 'Icono de marketing digital',
    items: [
      'Digitalización, automatización y desarrollo de soluciones empresariales.',
      'Integración de sistemas, herramientas de gestión y CRM.',
      'Desarrollo de tableros de control e indicadores de gestión.',
      'Desarrollo de landing pages, formularios y canales de captación.',
      'Gestión de campañas publicitarias en Meta Ads.',
      'Generación, seguimiento y medición de oportunidades comerciales.',
    ],
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4f0" />
    <link rel="icon" type="image/jpeg" href="/assets/brand/ag-consulting-logo.jpeg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header" aria-label="AG Consulting">
      <img class="header-logo" src="/assets/brand/ag-consulting-logo.jpeg" alt="AG Consulting" hidden />
    </header>
    <main>
      <section class="opening section-shell" aria-labelledby="opening-title">
        <div class="editorial-frame opening-frame">
        <div class="opening-copy">
          <p class="eyebrow">Presentación de asesoramiento</p>
          <h1 id="opening-title">CONSULTING</h1>
          <img class="opening-logo" src="/assets/brand/ag-consulting-logo.jpeg" alt="AG Consulting" width="1600" height="751" />
        </div>
        <div class="opening-art">
          <img src="/assets/illustrations/hero.png" alt="Composición arquitectónica en blanco y negro atravesada por una línea roja ascendente" />
        </div>
        </div>
        <span class="section-index" aria-hidden="true">01 / 07</span>
      </section>

      <section class="identity section-shell" aria-labelledby="identity-title">
        <div class="editorial-frame identity-frame">
        <div class="section-heading">
          <p class="eyebrow">01 — Identidad</p>
          <h2 id="identity-title">¿Quiénes somos?</h2>
        </div>
        <div class="identity-content">
          <p class="lead">Somos profesionales en planeación estratégica que mediante distintas metodologías:</p>
          <ul class="verb-list">
            <li>Identificamos</li>
            <li>Priorizamos</li>
            <li>Diseñamos e</li>
            <li>Implementamos</li>
          </ul>
          <p class="identity-ending">Cambios sustentables en las empresas.</p>
        </div>
        </div>
        <span class="section-index" aria-hidden="true">02 / 07</span>
      </section>

      <section class="what section-shell" aria-labelledby="what-title">
        <div class="editorial-frame what-frame">
        <div class="section-heading">
          <p class="eyebrow">02 — Nuestro trabajo</p>
          <h2 id="what-title">¿Qué hacemos?</h2>
        </div>
        <div class="what-content">
          <p class="lead">Ayudamos a empresas a:</p>
          <ul class="growth-list">
            <li>Crecer</li>
            <li>Incrementar rentabilidad</li>
          </ul>
          <p class="supporting-copy">A través de un enfoque sistemático en los valores del cliente.</p>
        </div>
        </div>
        <div class="shape-mark" aria-hidden="true"><span></span><span></span><span></span></div>
        <span class="section-index" aria-hidden="true">03 / 07</span>
      </section>

      <section class="approach section-shell" aria-labelledby="approach-title">
        <div class="editorial-frame approach-frame">
        <div class="section-heading">
          <p class="eyebrow">03 — Enfoque</p>
          <h2 id="approach-title">¿Cómo lo hacemos?</h2>
        </div>
        <p class="approach-copy">Sintonizando las metas, políticas y procesos, la cultura organizacional y ventas con la experiencia del cliente.</p>
        </div>
        <span class="section-index" aria-hidden="true">04 / 07</span>
      </section>

      <section class="practices section-shell" aria-labelledby="practices-title">
        <div class="editorial-frame practices-frame">
        <div class="section-heading practices-heading">
          <p class="eyebrow">04 — Áreas de trabajo</p>
          <h2 id="practices-title">Prácticas de Consultoría</h2>
        </div>
        <div class="practice-grid">
          {practices.map((practice) => (
            <article class="practice-card">
              <div class="practice-card-heading">
                <img src={practice.icon} alt={practice.iconAlt ?? ''} loading="lazy" />
                <h3>{practice.title}</h3>
              </div>
              <ul>
                {practice.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
        </div>
        <span class="section-index" aria-hidden="true">05 / 07</span>
      </section>

      <section class="purpose section-shell" aria-labelledby="purpose-title">
        <div class="editorial-frame purpose-frame">
        <div class="section-heading">
          <p class="eyebrow">05 — Propósito</p>
          <h2 id="purpose-title">¿Por qué lo hacemos?</h2>
        </div>
        <p class="purpose-copy">Porque creemos que la rentabilidad indica el valor que la empresa entrega a la sociedad.</p>
        </div>
        <span class="section-index" aria-hidden="true">06 / 07</span>
      </section>

      <section class="closing section-shell" aria-labelledby="closing-title">
        <div class="editorial-frame closing-frame">
        <div class="closing-copy">
          <p class="eyebrow">Contacto</p>
          <h2 id="closing-title">GRACIAS</h2>
          <address>
            <a href="mailto:miguel.oportoag@gmail.com">miguel.oportoag@gmail.com</a>
            <a href="tel:+59178002275">+591 78002275</a>
          </address>
        </div>
        <div class="closing-art">
          <img src="/assets/illustrations/closing.png" alt="Escalinata arquitectónica con un recorrido rojo ascendente" loading="lazy" />
        </div>
        </div>
        <span class="section-index" aria-hidden="true">07 / 07</span>
      </section>
    </main>
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (reduceMotion.matches) {
        const headerLogo = document.querySelector('.header-logo');
        const hero = document.querySelector('.opening');
        const updateHeaderLogo = () => {
          headerLogo.hidden = window.scrollY < hero.getBoundingClientRect().height;
        };

        updateHeaderLogo();
        window.addEventListener('scroll', updateHeaderLogo, { passive: true });
        window.addEventListener('resize', updateHeaderLogo);
      } else {
        const [{ gsap }, { ScrollTrigger }] = await Promise.all([
          import('gsap'),
          import('gsap/ScrollTrigger'),
        ]);

        gsap.registerPlugin(ScrollTrigger);
        const headerLogo = document.querySelector('.header-logo');
        headerLogo.hidden = false;
        const hero = document.querySelector('.opening');
        const heroEyebrow = document.querySelector('.opening .eyebrow');
        const heroHeading = document.querySelector('.opening h1');
        const heroLogo = document.querySelector('.opening-logo');
        const heroArtwork = document.querySelector('.opening-art');
        const revealTargets = gsap.utils.toArray(
          '.identity-content, .what-content, .approach-copy, .purpose-copy, .closing-copy, .closing-art',
        );
        const headingGroups = gsap.utils.toArray('main h1, main h2').map((heading) => {
          const label = heading.textContent.trim();
          heading.setAttribute('aria-label', label);
          heading.innerHTML = label
            .split(/\s+/)
            .map((word) => `<span aria-hidden="true">${word}</span>`)
            .join(' ');
          return { heading, words: gsap.utils.toArray('span', heading) };
        });
        const headingWords = headingGroups.flatMap(({ words }) => words);
        const practiceCards = gsap.utils.toArray('.practice-card');
        const practiceIcons = gsap.utils.toArray('.practice-card-heading img');
        const practiceTitles = gsap.utils.toArray('.practice-card-heading h3');
        const practiceItems = gsap.utils.toArray('.practice-card li');

        gsap.set([headerLogo, ...revealTargets, ...practiceCards], { autoAlpha: 0 });
        gsap.set(headingWords, { autoAlpha: 0, y: 10 });
        gsap.set([heroEyebrow, heroLogo, ...practiceTitles], { autoAlpha: 0, y: 8 });
        gsap.set(practiceIcons, { autoAlpha: 0, y: 6, scale: 0.97 });
        gsap.set(practiceItems, { autoAlpha: 0, y: 6 });
        gsap.set(heroArtwork, { autoAlpha: 0, y: 12 });
        document.documentElement.classList.add('motion-enabled');

        const heroTimeline = gsap.timeline({
          defaults: { ease: 'power3.out' },
        });
        heroTimeline
          .to(heroEyebrow, { autoAlpha: 1, y: 0, duration: 0.65 })
          .to(headingGroups[0].words, {
            autoAlpha: 1,
            y: 0,
            duration: 0.8,
            stagger: { each: 0.08, amount: 0.24 },
          }, '-=0.24')
          .to(heroLogo, { autoAlpha: 1, y: 0, duration: 0.7 }, '-=0.28')
          .to(heroArtwork, { autoAlpha: 1, y: 0, duration: 0.85 }, '-=0.48');

        gsap.to(headerLogo, {
          autoAlpha: 1,
          y: 0,
          duration: 0.3,
          ease: 'power1.out',
          scrollTrigger: {
            trigger: hero,
            start: 'bottom top',
            toggleActions: 'play none none reverse',
          },
        });

        headingGroups
          .filter(({ heading }) => heading !== heroHeading)
          .forEach(({ heading, words }) => {
          gsap.to(words, {
            autoAlpha: 1,
            y: 0,
            duration: 0.75,
            ease: 'power3.out',
            stagger: { each: 0.055, amount: 0.22 },
            scrollTrigger: {
              trigger: heading,
              start: 'top 88%',
              once: true,
            },
          });
          });

        revealTargets.forEach((target) => {
          gsap.to(target, {
            autoAlpha: 1,
            y: 0,
            duration: 0.75,
            ease: 'power3.out',
            scrollTrigger: {
              trigger: target,
              start: 'top 88%',
              once: true,
            },
          });
        });

        const practiceTimeline = gsap.timeline({
          scrollTrigger: {
            trigger: '.practice-grid',
            start: 'top 88%',
            once: true,
          },
          defaults: { ease: 'power3.out' },
        });
        practiceTimeline
          .to(practiceCards, {
            autoAlpha: 1,
            y: 0,
            duration: 0.75,
            stagger: { each: 0.09, amount: 0.36 },
          })
          .to(practiceIcons, {
            autoAlpha: 1,
            y: 0,
            scale: 1,
            duration: 0.7,
            stagger: { each: 0.06, amount: 0.24 },
          }, '-=0.55')
          .to(practiceTitles, {
            autoAlpha: 1,
            y: 0,
            duration: 0.7,
            stagger: { each: 0.06, amount: 0.24 },
          }, '-=0.58')
          .to(practiceItems, {
            autoAlpha: 1,
            y: 0,
            duration: 0.65,
            stagger: { each: 0.025, amount: 0.45 },
          }, '-=0.5');

        const parallaxMedia = gsap.matchMedia();
        parallaxMedia.add('(min-width: 760px)', () => {
          gsap.utils.toArray('.opening-art img, .closing-art img').forEach((artwork) => {
            gsap.to(artwork, {
              y: 16,
              ease: 'none',
              scrollTrigger: {
                trigger: artwork.parentElement,
                start: 'top bottom',
                end: 'bottom top',
                scrub: 0.6,
              },
            });
          });
        });

        const snapMedia = gsap.matchMedia();
        snapMedia.add('(min-width: 760px)', () => {
          const narrativePanels = gsap.utils.toArray(
            '.opening, .identity, .what, .approach, .purpose, .closing',
          );
          const practices = document.querySelector('.practices');
          const proximity = 220;

          ScrollTrigger.create({
            trigger: document.body,
            start: 'top top',
            end: 'max',
            snap: {
              snapTo: (progress, self) => {
                const maxScroll = ScrollTrigger.maxScroll(window);
                const projectedScroll = progress * maxScroll;
                const practicesStart = practices.getBoundingClientRect().top + window.scrollY;
                const practicesEnd = practicesStart + practices.offsetHeight;

                if (projectedScroll >= practicesStart && projectedScroll <= practicesEnd) {
                  return progress;
                }

                const nearestPanelStart = narrativePanels.reduce((nearest, panel) => {
                  const panelStart = panel.getBoundingClientRect().top + window.scrollY;
                  return Math.abs(panelStart - projectedScroll) < Math.abs(nearest - projectedScroll)
                    ? panelStart
                    : nearest;
                }, Number.POSITIVE_INFINITY);

                return Math.abs(nearestPanelStart - projectedScroll) <= proximity
                  ? nearestPanelStart / maxScroll
                  : progress;
              },
              delay: 0.12,
              duration: { min: 0.15, max: 0.35 },
              ease: 'power1.out',
              inertia: false,
            },
          });
        });
      }
    </script>
  </body>
</html>
